{
  "name": "chinese-learn",
  "version": "0.1.0",
  "private": true,
  "description": "愛愛院員工繁體中文學習平台",
  "author": "順元 (Shun-Yuan)",
  "prisma": {
    "schema": "prisma/schema"
  },
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start -p 3003",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,md}\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "ingest:pdf": "tsx scripts/ingest-pdf.ts",
    "ingest:tocfl": "tsx scripts/seed-tocfl.ts",
    "ingest:audio": "tsx scripts/generate-audio.ts",
    "docker:dev": "docker compose -f docker/docker-compose.yml up -d",
    "docker:dev:down": "docker compose -f docker/docker-compose.yml down",
    "docker:prod": "docker compose -f docker/docker-compose.prod.yml up -d",
    "test": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@prisma/client": "^5.22.0",
    "next-auth": "5.0.0-beta.25",
    "@auth/prisma-adapter": "^2.7.4",
    "next-intl": "^3.26.0",
    "next-pwa": "^5.6.0",
    "zustand": "^5.0.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-devtools": "^5.59.0",
    "framer-motion": "^11.11.0",
    "lottie-react": "^2.4.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.1",
    "lucide-react": "^0.460.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.0",
    "tailwindcss-animate": "^1.0.7",
    "react-hook-form": "^7.53.0",
    "@hookform/resolvers": "^3.9.0",
    "zod": "^3.23.0",
    "bullmq": "^5.21.0",
    "ioredis": "^5.4.0",
    "openai": "^4.73.0",
    "@anthropic-ai/sdk": "^0.32.0",
    "minio": "^8.0.0",
    "edge-tts": "^1.0.0",
    "tesseract.js": "^5.1.0",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.8.0",
    "fuse.js": "^7.0.0",
    "simhash-js": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.0",
    "date-fns": "^4.1.0",
    "react-canvas-draw": "^1.2.1",
    "wavesurfer.js": "^7.8.0",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/pdf-parse": "^1.1.0",
    "typescript": "^5.6.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "eslint": "^9.14.0",
    "eslint-config-next": "^15.0.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "vitest": "^2.1.0",
    "@playwright/test": "^1.48.0"
  }
}
