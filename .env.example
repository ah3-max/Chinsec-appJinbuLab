# ============================================
# ChineseLearn 環境變數設定
# ============================================

# === 應用程式 ===
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=ChineseLearn
NEXT_PUBLIC_APP_URL=http://localhost:3003
PORT=3003

# === 資料庫 ===
DATABASE_URL="postgresql://chinese_learn:chinese_learn_dev_pwd@localhost:5435/chinese_learn?schema=public"

# === Redis (BullMQ + Cache) ===
REDIS_URL="redis://:chinese_learn_redis_pwd@localhost:6381"

# === MinIO (檔案儲存) ===
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=chinese_learn_minio_pwd
MINIO_BUCKET_AUDIO=chinese-learn-audio
MINIO_BUCKET_HANDWRITING=chinese-learn-handwriting
MINIO_BUCKET_HOMEWORK=chinese-learn-homework

# === 身份驗證 (NextAuth v5) ===
AUTH_SECRET=CHANGE_ME_RUN_npx_auth_secret
AUTH_TRUST_HOST=true

# === LM Studio (主要 AI 推論，內網) ===
# 順元會提供實際 IP 與 API Key
LM_STUDIO_BASE_URL=http://192.168.1.XXX:1234/v1
LM_STUDIO_API_KEY=lm-studio-placeholder
LM_STUDIO_MODEL=qwen2.5-72b-instruct

# === Ollama (備援，R770) ===
OLLAMA_BASE_URL=http://192.168.1.214:11434
OLLAMA_MODEL=qwen2.5:latest

# === Claude API (進階批改、課程設計) ===
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
ANTHROPIC_MODEL=claude-sonnet-4-6

# === AI 智慧分流策略 ===
# internal_first: 先用 LM Studio，失敗才用 Claude
# claude_only: 只用 Claude (測試用)
# ollama_only: 只用 Ollama (離線測試)
AI_ROUTING_STRATEGY=internal_first

# === 網路模式 ===
# internal: 內網 (預設)
# external: 外網 (透過 Cloudflare Tunnel)
NETWORK_MODE=internal
EXTERNAL_DOMAIN=lingo.your-domain.com

# === TTS (繁體中文語音生成) ===
TTS_PROVIDER=edge          # edge / azure / lm-studio
EDGE_TTS_VOICE=zh-TW-HsiaoChenNeural

# === STT (Whisper 語音辨識) ===
STT_PROVIDER=lm-studio     # lm-studio / openai-api
WHISPER_MODEL=whisper-large-v3

# === 防抄襲 ===
PLAGIARISM_THRESHOLD=0.85  # 相似度警告門檻
PLAGIARISM_USE_AI=true     # 啟用語義抄襲檢測

# === 預留 HR/LTC-IMS 整合 (現階段不啟用) ===
HR_API_URL=
HR_API_KEY=
LTC_IMS_API_URL=
LTC_IMS_API_KEY=
ENABLE_HR_SYNC=false
ENABLE_LTC_SYNC=false

# === OpenClaw Heartbeat 監控整合 ===
HEARTBEAT_WEBHOOK_URL=
HEARTBEAT_TASK_NAME=chinese-learn-heartbeat
HEARTBEAT_REPORT_INTERVAL=300  # 5 分鐘

# === 監控與日誌 ===
LOG_LEVEL=info
SENTRY_DSN=

# === 多語系 ===
DEFAULT_LOCALE=zh-TW
SUPPORTED_LOCALES=zh-TW,th,vi,id,en

# === 上傳限制 ===
MAX_AUDIO_SIZE_MB=20
MAX_IMAGE_SIZE_MB=10
MAX_HOMEWORK_SIZE_MB=50

# === 速率限制 ===
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=20
